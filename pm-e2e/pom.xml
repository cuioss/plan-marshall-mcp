<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.planmarshall</groupId>
        <artifactId>plan-marshall-mcp-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>pm-e2e</artifactId>
    <packaging>jar</packaging>
    <name>pm-e2e</name>
    <description>Release-shape end-to-end tests over the four native binaries.</description>
    <properties>
        <maven.jar.plugin.automatic.module.name>de.planmarshall.e2e</maven.jar.plugin.automatic.module.name>
        <!-- Switches on the rule of the root POM for pm-e2e -->
        <pm.guard.binaries-only.skip>false</pm.guard.binaries-only.skip>
        <!-- Enabled by the integration-tests profile -->
        <skipITs>true</skipITs>
        <!-- See the failsafe configuration of the integration-tests profile -->
        <pm.clients.checkout>${maven.multiModuleProjectDirectory}/../pm-mcp-clients</pm.clients.checkout>
    </properties>
    <dependencies>
        <!-- Build order only: pm-e2e stages pm-mcpd of this build and never uses the classes of pm-mcp-server
             (type pom, so no class reaches the test classpath). The three client binaries come from
             pm-mcp-clients. -->
        <dependency>
            <groupId>de.planmarshall</groupId>
            <artifactId>pm-mcp-server</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- Runs the *IT tests -->
        <profile>
            <id>integration-tests</id>
            <properties>
                <skipITs>false</skipITs>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skipTests>true</skipTests>
                        </configuration>
                    </plugin>
                    <!-- JVM layout: the client JARs and their runtime class path, which the staged launcher
                         scripts of pm-mcp, pm-operator and pm-exec run (pm-mcpd runs the Quarkus runner JAR of
                         pm-mcp-server); the native layout stages the native binaries instead -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>stage-jvm-layout</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/e2e-jvm-lib</outputDirectory>
                                    <stripVersion>true</stripVersion>
                                    <overWriteReleases>true</overWriteReleases>
                                    <overWriteSnapshots>true</overWriteSnapshots>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>de.planmarshall</groupId>
                                            <artifactId>pm-relay</artifactId>
                                            <version>${version.pm-mcp-clients}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>de.planmarshall</groupId>
                                            <artifactId>pm-operator</artifactId>
                                            <version>${version.pm-mcp-clients}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>de.planmarshall</groupId>
                                            <artifactId>pm-exec</artifactId>
                                            <version>${version.pm-mcp-clients}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>de.planmarshall</groupId>
                                            <artifactId>pm-api</artifactId>
                                            <version>${version.pm-mcp-clients}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>info.picocli</groupId>
                                            <artifactId>picocli</artifactId>
                                            <version>${version.picocli}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>com.fasterxml.jackson.core</groupId>
                                            <artifactId>jackson-core</artifactId>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <skipITs>${skipITs}</skipITs>
                            <systemPropertyVariables>
                                <!-- The checkout of pm-mcp-clients whose native build supplies the three client
                                     binaries of the native layout; default: beside this repository -->
                                <pm.clients.checkout>${pm.clients.checkout}</pm.clients.checkout>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
