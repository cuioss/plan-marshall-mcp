<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Control of a build guard of the root POM: this project is no module of the build and must fail.
         It is a template: BuildGuardsIT writes it to target/guard-controls with the version of the build
         in place of @project.version@, so that a version change of the root POM needs no change here.
         BuildGuardsIT of pm-mcp-server builds it and expects the failure. It depends on the classes of pm-mcp-server, where pm-e2e may only order the build. -->
    <parent>
        <groupId>de.planmarshall</groupId>
        <artifactId>plan-marshall-mcp-parent</artifactId>
        <version>@project.version@</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>
    <artifactId>guard-control-e2e-assembly-classes</artifactId>
    <packaging>pom</packaging>
    <name>guard-control-e2e-assembly-classes</name>
    <properties>
        <pm.guard.binaries-only.skip>false</pm.guard.binaries-only.skip>
    </properties>
    <dependencies>
        <dependency>
            <groupId>de.planmarshall</groupId>
            <artifactId>pm-mcp-server</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>
