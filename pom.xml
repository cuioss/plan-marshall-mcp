<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.cuioss</groupId>
        <artifactId>cui-quarkus-parent</artifactId>
        <version>1.7.5</version>
        <relativePath />
    </parent>
    <artifactId>plan-marshall-mcp-parent</artifactId>
    <version>0.1.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <!-- Must be declared: <inceptionYear> is inherited, and the license plugin binds the
         copyright ${year} to it. Without this, the project reports cui-parent-pom's 2022
         and every -Ppre-commit run restamps every header. -->
    <inceptionYear>2026</inceptionYear>
    <name>plan-marshall-mcp Parent</name>
    <description>Local MCP server that takes over plan-marshall's process logic via a
        hypermedia-driven workflow.
    </description>
    <url>https://github.com/cuioss/plan-marshall-mcp/</url>
    <!-- Overrides the Apache-2.0 license inherited from cui-parent-pom. -->
    <licenses>
        <license>
            <name>Functional Source License, Version 1.1, ALv2 Future License (FSL-1.1-ALv2)</name>
            <url>https://github.com/cuioss/plan-marshall-mcp/blob/main/LICENSE.md</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <modules>
        <module>plan-marshall-mcp</module>
        <module>integration-tests</module>
    </modules>
    <scm>
        <url>https://github.com/cuioss/plan-marshall-mcp/</url>
        <connection>
            scm:git:https://github.com/cuioss/plan-marshall-mcp.git
        </connection>
        <developerConnection>
            scm:git:https://github.com/cuioss/plan-marshall-mcp/
        </developerConnection>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <url>https://github.com/cuioss/plan-marshall-mcp/issues</url>
        <system>GitHub Issues</system>
    </issueManagement>

    <properties>
        <!-- Read by cui-parent-pom's compiler <release> and by both javadoc configurations of
             cui-java-parent (pluginManagement and the pre-commit check-javadocs execution) -->
        <maven.compiler-plugin.release>25</maven.compiler-plugin.release>
        <version.token-sheriff>0.9.6</version.token-sheriff>
        <version.quarkus-mcp-server>2.0.1</version.quarkus-mcp-server>
        <!-- Default empty argLine for JaCoCo compatibility - JaCoCo overrides it when active -->
        <argLine />
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- version.quarkus is inherited from cui-quarkus-parent. The BOM is restated here,
                 FIRST, so that it wins the smallrye-config convergence over the BOMs below; the
                 organisation's quarkus-alignment CI job fails on a split Quarkus line. -->
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${version.quarkus}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>de.cuioss</groupId>
                <artifactId>java-ee-orthogonal</artifactId>
                <version>${version.cui.parent}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>de.cuioss</groupId>
                <artifactId>java-ee-10-bom</artifactId>
                <version>${version.cui.parent}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- TokenSheriff: OAuth resource-server validation and OAuth/OIDC client flows -->
            <dependency>
                <groupId>de.cuioss.sheriff.token</groupId>
                <artifactId>token-sheriff-bom</artifactId>
                <version>${version.token-sheriff}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Quarkiverse MCP Server -->
            <dependency>
                <groupId>io.quarkiverse.mcp</groupId>
                <artifactId>quarkus-mcp-server-bom</artifactId>
                <version>${version.quarkus-mcp-server}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Internal modules -->
            <dependency>
                <groupId>de.cuioss</groupId>
                <artifactId>plan-marshall-mcp</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <showDeprecation>true</showDeprecation>
                        <failOnWarning>true</failOnWarning>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                            <quarkus.test.arg-line>@{argLine}</quarkus.test.arg-line>
                        </systemPropertyVariables>
                        <useModulePath>false</useModulePath>
                        <useFile>false</useFile>
                        <trimStackTrace>false</trimStackTrace>
                        <enableAssertions>true</enableAssertions>
                        <argLine>@{argLine} -XX:+IgnoreUnrecognizedVMOptions -Djava.awt.headless=true</argLine>
                        <forkedProcessTimeoutInSeconds>0</forkedProcessTimeoutInSeconds>
                        <forkedProcessExitTimeoutInSeconds>60</forkedProcessExitTimeoutInSeconds>
                        <useSystemClassLoader>false</useSystemClassLoader>
                        <reuseForks>false</reuseForks>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                        </systemPropertyVariables>
                        <useModulePath>false</useModulePath>
                        <useFile>false</useFile>
                        <trimStackTrace>false</trimStackTrace>
                        <enableAssertions>true</enableAssertions>
                        <argLine>@{argLine} -XX:+IgnoreUnrecognizedVMOptions -Djava.awt.headless=true</argLine>
                        <useSystemClassLoader>false</useSystemClassLoader>
                        <reuseForks>false</reuseForks>
                        <includes>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Overrides the parent's OpenRewrite recipe list; identical except for the two
             exclusions documented inline. combine.children="override" is required: Maven appends
             inherited activeRecipes, so a single recipe cannot be removed any other way. Keep the
             list in sync with cui-java-parent by hand. -->
        <profile>
            <id>pre-commit</id>
            <build>
                <plugins>
                    <!-- Replaces the parent's Apache-2.0 header template with the FSL-1.1-ALv2
                         header and sets the licensor named in LICENSE.md as owner; the year stays inherited
                         from cui-java-parent. -->
                    <plugin>
                        <groupId>com.mycila</groupId>
                        <artifactId>license-maven-plugin</artifactId>
                        <configuration>
                            <properties>
                                <owner>Oliver Wolff</owner>
                            </properties>
                            <licenseSets combine.children="override">
                                <licenseSet>
                                    <header>${maven.multiModuleProjectDirectory}/src/license/header.txt</header>
                                    <includes>
                                        <include>src/main/java/**</include>
                                        <include>src/test/java/**</include>
                                    </includes>
                                </licenseSet>
                            </licenseSets>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.openrewrite.maven</groupId>
                        <artifactId>rewrite-maven-plugin</artifactId>
                        <configuration>
                            <activeRecipes combine.children="override">
                                <recipe>org.openrewrite.java.format.AutoFormat</recipe>
                                <recipe>org.openrewrite.java.format.NormalizeLineBreaks</recipe>
                                <recipe>org.openrewrite.java.format.RemoveTrailingWhitespace</recipe>
                                <recipe>de.cuioss.rewrite.format.AnnotationNewlineFormat</recipe>
                                <recipe>de.cuioss.rewrite.logging.CuiLoggerStandardsRecipe</recipe>
                                <recipe>de.cuioss.rewrite.logging.CuiLogRecordPatternRecipe</recipe>
                                <recipe>de.cuioss.rewrite.logging.InvalidExceptionUsageRecipe</recipe>
                                <!-- UpgradeToJava21 (and UpgradeToJava25, which contains it) intentionally
                                     excluded: it rewrites the compiler release back to 21, and its chain
                                     reaches RenameUnderscoreIdentifier, which turns Java 22+ unnamed
                                     variables (catch (X _)) into non-compiling source. A Java-8-to-21
                                     migration has nothing to do on a Java 25 codebase (as in API-Sheriff). -->
                                <recipe>org.openrewrite.java.migrate.RemoveSecurityManager</recipe>
                                <!-- JavaUtilAPIs intentionally excluded, as in the parent: its UseMapOf
                                     produces non-compiling output. -->
                                <recipe>org.openrewrite.java.OrderImports</recipe>
                                <recipe>org.openrewrite.java.RemoveUnusedImports</recipe>
                                <recipe>org.openrewrite.java.ShortenFullyQualifiedTypeReferences</recipe>
                                <recipe>org.openrewrite.java.testing.junit5.JUnit5BestPractices</recipe>
                                <recipe>org.openrewrite.java.testing.junit5.RemoveTryCatchFailBlocks</recipe>
                                <recipe>org.openrewrite.staticanalysis.EqualsAvoidsNull</recipe>
                                <recipe>org.openrewrite.staticanalysis.NoPrimitiveWrappersForToStringOrCompareTo</recipe>
                                <recipe>org.openrewrite.staticanalysis.SimplifyBooleanExpression</recipe>
                                <recipe>org.openrewrite.staticanalysis.UnnecessaryParentheses</recipe>
                            </activeRecipes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>coverage</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.jacoco</groupId>
                            <artifactId>jacoco-maven-plugin</artifactId>
                            <executions>
                                <execution>
                                    <id>prepare-agent</id>
                                    <goals>
                                        <goal>prepare-agent</goal>
                                    </goals>
                                    <configuration>
                                        <append>true</append>
                                        <destFile>${project.build.directory}/jacoco.exec</destFile>
                                        <!-- @QuarkusTest classes are instrumented by quarkus-jacoco,
                                             which writes into the same data file (application.properties) -->
                                        <exclClassLoaders>*QuarkusClassLoader</exclClassLoaders>
                                    </configuration>
                                </execution>
                                <execution>
                                    <id>report</id>
                                    <phase>test</phase>
                                    <goals>
                                        <goal>report</goal>
                                    </goals>
                                    <configuration>
                                        <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
                                        <formats>
                                            <format>XML</format>
                                            <format>HTML</format>
                                        </formats>
                                    </configuration>
                                </execution>
                            </executions>
                        </plugin>
                    </plugins>
                </pluginManagement>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
            <properties>
                <sonar.coverage.jacoco.xmlReportPaths>
                    ${project.build.directory}/site/jacoco/jacoco.xml,
                    plan-marshall-mcp/target/site/jacoco/jacoco.xml,
                    ../target/site/jacoco/jacoco.xml
                </sonar.coverage.jacoco.xmlReportPaths>
            </properties>
        </profile>
    </profiles>
</project>
