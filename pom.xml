<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Resolved from the package registry of the organisation plan-marshall (.mvn/settings.xml). It holds the
         Java release, the licence, the quality-gate recipes, the managed third-party versions, the plugin
         management, and the deployment target with the build check that guards it. -->
    <parent>
        <groupId>de.planmarshall</groupId>
        <artifactId>pm-mcp-parent</artifactId>
        <version>0.1.1</version>
        <relativePath />
    </parent>
    <artifactId>plan-marshall-mcp-parent</artifactId>
    <version>0.1.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>plan-marshall-mcp Parent</name>
    <description>Local MCP server that takes over plan-marshall's process logic via a
        hypermedia-driven workflow.
    </description>
    <url>https://github.com/plan-marshall/plan-marshall-mcp/</url>
    <!-- Restated: the licence URL of the parent names the parent's repository. -->
    <licenses>
        <license>
            <name>Proprietary - all rights reserved</name>
            <url>https://github.com/plan-marshall/plan-marshall-mcp/blob/main/LICENSE.md</url>
            <distribution>manual</distribution>
        </license>
    </licenses>
    <modules>
        <module>pm-mcp-server</module>
        <module>pm-e2e</module>
    </modules>
    <scm>
        <url>https://github.com/plan-marshall/plan-marshall-mcp/</url>
        <connection>
            scm:git:https://github.com/plan-marshall/plan-marshall-mcp.git
        </connection>
        <developerConnection>
            scm:git:https://github.com/plan-marshall/plan-marshall-mcp/
        </developerConnection>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <url>https://github.com/plan-marshall/plan-marshall-mcp/issues</url>
        <system>GitHub Issues</system>
    </issueManagement>

    <properties>
        <!-- The repository of this POM: the deployment target of the parent is
             https://maven.pkg.github.com/plan-marshall/${pm.repository}, and its enforcer rule fails without it. -->
        <pm.repository>plan-marshall-mcp</pm.repository>
        <!-- The modules of pm-mcp-clients (pm-api, pm-exec, pm-relay, pm-operator), resolved from the organisation
             registry: always the latest SNAPSHOT, they are never released. -->
        <version.pm-mcp-clients>0.1.0-SNAPSHOT</version.pm-mcp-clients>
        <!-- The modules of pm-mcp-core (pm-core, pm-runtime, the provider modules), resolved the same way -->
        <version.pm-mcp-core>0.1.0-SNAPSHOT</version.pm-mcp-core>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- pm-mcp-server of this repository, and the modules of pm-mcp-clients and pm-mcp-core, each
                 repository by its one version property -->
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-api</artifactId>
                <version>${version.pm-mcp-clients}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-exec</artifactId>
                <version>${version.pm-mcp-clients}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-core</artifactId>
                <version>${version.pm-mcp-core}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-runtime</artifactId>
                <version>${version.pm-mcp-core}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-provider-git</artifactId>
                <version>${version.pm-mcp-core}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-provider-ci</artifactId>
                <version>${version.pm-mcp-core}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-provider-github</artifactId>
                <version>${version.pm-mcp-core}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-provider-gitlab</artifactId>
                <version>${version.pm-mcp-core}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-relay</artifactId>
                <version>${version.pm-mcp-clients}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-operator</artifactId>
                <version>${version.pm-mcp-clients}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-mcp-server</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- This repository deploys nothing yet: the product is released from here later, and until
                     then even an explicit `mvn deploy` uploads nothing. The target stays the one of the
                     parent. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>coverage</id>
            <properties>
                <!-- Adds the report of the daemon assembly, which the SonarCloud analysis of the root reads -->
                <sonar.coverage.jacoco.xmlReportPaths>
                    ${project.build.directory}/site/jacoco/jacoco.xml,
                    pm-mcp-server/target/site/jacoco/jacoco.xml,
                    ../target/site/jacoco/jacoco.xml
                </sonar.coverage.jacoco.xmlReportPaths>
            </properties>
        </profile>
    </profiles>
</project>
