# PM-MCP container image (JVM mode).
# Build: ./mvnw package -pl plan-marshall-mcp -am, then
#        docker build -f src/main/docker/Dockerfile.jvm -t plan-marshall-mcp:jvm plan-marshall-mcp
# The target image is a native executable on a distroless base (doc/concept/10-technology.adoc);
# this JVM image is the interim form. It therefore avoids shell-based entrypoints and health checks.
FROM registry.access.redhat.com/ubi9/openjdk-25-runtime:1.24@sha256:335d3b531374ddc4dc89ad4953285360ccc522b7f4a3daa626581fb17c162bea

ARG APP_VERSION=dev
ARG APP_REVISION=dev
LABEL org.opencontainers.image.title="plan-marshall-mcp"
LABEL org.opencontainers.image.description="PM-MCP: local MCP server for the plan-marshall workflow (JVM mode)"
LABEL org.opencontainers.image.version="${APP_VERSION}"
LABEL org.opencontainers.image.revision="${APP_REVISION}"
LABEL org.opencontainers.image.vendor="CUIoss"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.source="https://github.com/cuioss/plan-marshall-mcp"
LABEL org.opencontainers.image.base.name="registry.access.redhat.com/ubi9/openjdk-25-runtime:1.24"

ENV LANGUAGE='en_US:en'

# Quarkus fast-jar layout, copied in four layers from least to most frequently changed.
COPY --chown=185 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185 target/quarkus-app/*.jar /deployments/
COPY --chown=185 target/quarkus-app/app/ /deployments/app/
COPY --chown=185 target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080 9000
USER 185

# The application answers the probe itself (TCP connect to the management port 9000, see HealthProbe),
# so the check needs neither a shell nor curl.
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD ["java", "-XX:TieredStopAtLevel=1", "-Xshare:auto", "-jar", "/deployments/quarkus-run.jar", "--health-probe"]

ENTRYPOINT ["java", "-Dquarkus.http.host=0.0.0.0", "-Dquarkus.management.host=0.0.0.0", "-Djava.util.logging.manager=org.jboss.logmanager.LogManager", "-jar", "/deployments/quarkus-run.jar"]
