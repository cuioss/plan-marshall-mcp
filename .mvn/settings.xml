<?xml version="1.0" encoding="UTF-8"?>
<!--
  Repository-wide Maven settings, passed as global settings through .mvn/maven.config, so the personal
  ~/.m2/settings.xml stays in force and takes precedence. This file holds no token.

  Every artifact of the product is resolved from the GitHub Packages registry of the organisation plan-marshall,
  which answers no anonymous request. The server "plan-marshall" below reads the workflow token in CI. On a
  developer machine a <server> with the same id in ~/.m2/settings.xml replaces it
  (doc/developer/registry-setup.adoc).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <servers>
        <server>
            <id>plan-marshall</id>
            <username>${env.GITHUB_ACTOR}</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
    </servers>
    <profiles>
        <profile>
            <id>plan-marshall</id>
            <repositories>
                <!-- Asked first, so that no third-party artifact is looked up in the organisation registry -->
                <repository>
                    <id>central</id>
                    <url>https://repo.maven.apache.org/maven2</url>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>plan-marshall</id>
                    <url>https://maven.pkg.github.com/plan-marshall/*</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                        <updatePolicy>always</updatePolicy>
                    </snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>plan-marshall</activeProfile>
    </activeProfiles>
</settings>
